# Replace placeholders in an ignored backend/.env; dotenv loads .env by default.
# Set NODE_ENV to production, PORT to the local API port, and FRONTEND_ORIGIN
# to the exact HTTPS origin without a trailing slash.
NODE_ENV=<production>
PORT=<local_api_port>
FRONTEND_ORIGIN=<https_production_origin>

DB_HOST=<local_mysql_host>
DB_PORT=<mysql_port>
DB_NAME=<database_name>
DB_USER=<restricted_runtime_database_user>
DB_PASSWORD=<database_password>

# Generate independent secrets; each secret below needs at least 32 characters.
JWT_ACCESS_SECRET=<independent_random_access_secret>
JWT_REFRESH_SECRET=<independent_random_refresh_secret>
IDENTITY_BLIND_INDEX_KEY=<independent_random_identity_index_key>
PHONE_BLIND_INDEX_KEY=<independent_random_phone_index_key>
# Must decode to exactly 32 random bytes; preserve this key across deployments.
DATA_ENCRYPTION_KEY_V1=<base64url_encoded_32_random_bytes>

BOOKING_DOCTOR_IDS=<comma_separated_production_doctor_ids>
CLINICAL_IMAGE_STORAGE_ROOT=<absolute_private_persistent_directory>

# Set EMAIL_ENABLED to true or false. Omit SMTP/mailbox variables if disabled.
EMAIL_ENABLED=<true_or_false>
SMTP_HOST=<smtp_host>
SMTP_PORT=<smtp_port>
SMTP_SECURE=<true_or_false>
CLINIC_EMAIL_ADDRESS=<clinic_mailbox_address>
CLINIC_EMAIL_APP_PASSWORD=<mailbox_app_password>

# Optional backend-only integration: omit these variables when unused.
GOOGLE_PLACES_API_KEY=<private_google_places_api_key>
GOOGLE_PLACE_ID=<google_place_id>
