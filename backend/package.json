{
  "name": "dental-clinic-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "description": "Express and MySQL API for Klinik Pergigian Rosni Adam",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:integration",
    "test:db:prepare": "node --env-file=.env.test scripts/prepareTestDatabase.js --reset && node --env-file=.env.test scripts/runMigrations.js && node --env-file=.env.test scripts/seedIntegrationTestPrerequisites.js",
    "test:integration": "node --env-file=.env.test scripts/runIntegrationTests.js",
    "seed:auth": "node scripts/provisionAuthAccounts.js",
    "seed:doctor-b": "node scripts/provisionTemporaryDoctorB.js",
    "seed:doctors": "node scripts/seedClinicDoctors.js",
    "seed:operations": "node scripts/seedClinicOperations.js",
    "seed:clinical": "node scripts/seedClinicalRecords.js",
    "migrate": "node scripts/runMigrations.js",
    "seed:dental-chart-dev": "node scripts/seedDevelopmentDentalChartDefinitions.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
