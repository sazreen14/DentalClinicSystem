NODE_ENV=test
PORT=5001
FRONTEND_ORIGIN=http://localhost:5173

# Dedicated disposable database only. The name must end with _test.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dental_clinic_test
DB_USER=replace_with_dedicated_test_database_user
DB_PASSWORD=replace_with_test_database_password
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=5000

# Generate independent test-only secrets. Never copy production values here.
JWT_ACCESS_SECRET=replace_with_test_only_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_test_only_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
BOOKING_DOCTOR_IDS=DOC-DEV-ROSNI,DOC-DEV-DOCTOR-B

DATA_ENCRYPTION_KEY_V1=replace_with_test_only_base64url_encoded_32_random_bytes
IDENTITY_BLIND_INDEX_KEY=replace_with_test_only_blind_index_key_at_least_32_characters
PHONE_BLIND_INDEX_KEY=replace_with_another_test_only_key_at_least_32_characters

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
CLINIC_EMAIL_ADDRESS=clinic@example.test
CLINIC_EMAIL_APP_PASSWORD=replace_with_test_only_app_password

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_TIMEOUT_MS=5000
GOOGLE_REVIEWS_CACHE_TTL_MS=3600000

# Keep test uploads separate from development clinical images.
CLINICAL_IMAGE_STORAGE_ROOT=private-data/test-clinical-images
CLINICAL_IMAGE_MAX_BYTES=8388608

DENTAL_CHART_CATALOGUE_DISCLAIMER=Prototype Dental Chart definitions require review by an authorised dental professional before clinical deployment.
