NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dental_clinic
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Only these legitimate clinic Doctor public IDs are selectable by Patients.
BOOKING_DOCTOR_IDS=DOC-DEV-ROSNI,DOC-DEV-DOCTOR-B

DATA_ENCRYPTION_KEY_V1=replace_with_base64url_encoded_32_random_bytes
IDENTITY_BLIND_INDEX_KEY=replace_with_at_least_32_random_characters
PHONE_BLIND_INDEX_KEY=replace_with_a_different_32_character_secret

# All system email uses the clinic mailbox. Use a Google App Password, never the normal account password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
CLINIC_EMAIL_ADDRESS=kprosniadam06@gmail.com
CLINIC_EMAIL_APP_PASSWORD=replace_with_google_app_password

# Google Places API (New), backend-only. Leave blank for truthful unavailable state.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_TIMEOUT_MS=5000
GOOGLE_REVIEWS_CACHE_TTL_MS=3600000

# Development/FYP CLI provisioning only. Never commit real passwords.
SEED_DOCTOR_PASSWORD=
# Optional Doctor B-specific override. If empty, seed:doctor-b uses SEED_DOCTOR_PASSWORD.
SEED_DOCTOR_B_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_OVERWRITE_PASSWORDS=false

# Private encrypted clinical-image storage. Must remain outside frontend/public.
CLINICAL_IMAGE_STORAGE_ROOT=private-data/clinical-images
CLINICAL_IMAGE_MAX_BYTES=8388608

# Application-level notice shown with the Dental Chart catalogue.
DENTAL_CHART_CATALOGUE_DISCLAIMER=Prototype Dental Chart definitions require review by an authorised dental professional before clinical deployment.

# Patient email verification (30 minute expiry; per-account cooldown).
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
