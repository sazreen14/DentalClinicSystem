# Replace placeholders in an ignored .env.production before building.
# Set the API base to /api for same-origin production deployment.
# VITE_* values are public browser configuration; never put secrets here.
VITE_API_BASE_URL=<same_origin_api_path>

# Optional integrations: omit these variables when unused.
VITE_GOOGLE_MAPS_EMBED_KEY=<public_referrer_restricted_maps_embed_key>
VITE_GOOGLE_MAPS_PLACE_ID=<google_maps_place_id>
VITE_GOOGLE_REVIEWS_URL=<verified_public_google_reviews_url>
