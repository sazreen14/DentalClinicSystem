# Public browser configuration only. Restrict this key to the Maps Embed API
# and to authorized website HTTP referrers in Google Cloud Console.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Optional. When omitted, the backend-provided clinic address is used.
VITE_GOOGLE_MAPS_PLACE_ID=

# Public, non-secret URL for the clinic's verified Google Maps review/profile page.
# Insert the exact clinic URL verified by its owner.
VITE_GOOGLE_REVIEWS_URL=

VITE_API_BASE_URL=http://localhost:5000/api
